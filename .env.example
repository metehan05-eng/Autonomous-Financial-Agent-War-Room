# Autonomous Financial Agent War Room - example configuration
# Copy to `.env` and adjust. Every variable is optional: without any LLM
# configuration the War Room automatically uses the rule-based fallback engine.

# Provider selection: auto | evren | ollama | openai | gemini | anthropic | fallback
LLM_PROVIDER=auto

# --- Evren gateway (default, official openai SDK) ---------------------------
# Streams reasoning (delta.reasoning_content) into the debate log and runs
# tool-calling turns on EVREN_TOOL_MODEL. In auto mode Evren is probed first.
EVREN_BASE_URL=https://evren-llmapi.ssyz.org.tr/v1
EVREN_API_KEY=
EVREN_MODEL=deepseek-v4.1-flash
EVREN_TOOL_MODEL=glm-5.3

# --- Local models (Ollama) -------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder
# Other popular choices: llama3.2, mistral, phi4, deepseek-r1

# --- Cloud APIs ------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Behaviour -------------------------------------------------------------
# LLM_TIMEOUT / LLM_ROUNDS / LLM_MAX_TOKENS / LLM_TEMPERATURE are respected.
# NOTE: there is no silent fallback any more - if no LLM answers the debate
# stops with an error. Use `--no-llm` for the deterministic rule engine.
# Reasoning models stream chain-of-thought live into the log; a full debate on
# a verbose model can take several minutes. `--rounds 2` skips the second
# cross-examination for a quicker run.
LLM_TIMEOUT=45
LLM_PROBE_TIMEOUT=2.5
LLM_ROUNDS=3
# LLM_MAX_TOKENS must leave room for the visible answer after reasoning -
# too small a budget yields reasoning-only (empty) replies.
LLM_MAX_TOKENS=3000
LLM_TEMPERATURE=0.7

DEFAULT_TICKER=AAPL
HISTORY_PERIOD=1y
